{
  "name": "vision-ai-construction-safety",
  "version": "1.0.0",
  "description": "Vision AI agent with RAG for construction safety compliance using OSHA standards.",
  "scripts": {
    "backend": "uvicorn backend.app.main:app --reload --port 8000",
